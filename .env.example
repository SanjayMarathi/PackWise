# Copy to .env and fill in real values. Never commit .env.

# --- Django
DJANGO_SETTINGS_MODULE=config.settings.production
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set to false only when nothing in front of the app terminates TLS (e.g. local prod-like runs).
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=3600

# --- Database (docker-compose.prod.yml builds DATABASE_URL from these)
POSTGRES_DB=packwise
POSTGRES_USER=packwise
POSTGRES_PASSWORD=change-me
# Outside docker compose, set DATABASE_URL directly:
# DATABASE_URL=postgres://packwise:change-me@localhost:5432/packwise

# --- Runtime
PACKWISE_IMAGE=packwise:local
WEB_CONCURRENCY=3
RUN_MIGRATIONS=false
SEED_DEMO_DATA=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Packing behaviour
PACKWISE_RANKING_STRATEGY=lowest_cost      # lowest_cost | best_utilization | smallest_box
PACKWISE_MAX_ITEMS_PER_ORDER=200
PACKWISE_MAX_LINES_PER_ORDER=50
PACKWISE_MIN_SUPPORT_RATIO=0               # 0 = allow overhang (void fill), 1 = full support

# --- Throttling
THROTTLE_ANON_RATE=120/minute
THROTTLE_RECOMMEND_RATE=30/minute
